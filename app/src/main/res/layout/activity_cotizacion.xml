<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CotizacionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/strCliente"
            android:textAlignment="center"
            android:textColor="@color/red"
            android:textSize="25dp"
            android:textStyle="bold"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:id="@+id/txtCliente">

        </TextView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/strNumFolio"
            android:paddingLeft="10dp"
            android:textStyle="bold"
            android:textSize="15dp"
            android:paddingBottom="10dp"
            android:id="@+id/txtFolio">

        </TextView>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/strDescripcion"
            android:paddingBottom="20dp"
            android:paddingTop="20dp"
            android:id="@+id/txtDescripcion">

        </EditText>
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:hint="@string/strPortcentaje"
            android:inputType="numberDecimal"
            android:textAlignment="textEnd"
            android:id="@+id/txtPorcentaje">

        </EditText>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:hint="@string/strValorAuto"
            android:inputType="numberDecimal"
            android:textAlignment="textEnd"
            android:id="@+id/txtPrecio">

        </EditText>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/strPlazos"
            android:textColor="@color/red"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textSize="30dp">

        </TextView>

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center">

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/rdb12"
                android:text="@string/str12Meses"
                android:layout_gravity="left"
                android:checked="true"
                android:textSize="20sp">

            </RadioButton>

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/rdb24"
                android:text="@string/str24Meses"
                android:layout_gravity="left"
                android:textSize="20sp">

            </RadioButton>
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/rdb36"
                android:text="@string/str36Meses"
                android:layout_gravity="left"

                android:textSize="20sp">

            </RadioButton>
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/rdb48"
                android:text="@string/str48Meses"
                android:layout_gravity="left"
                android:textSize="20sp">

            </RadioButton>

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="5sp">
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/strBtnCalcularCot"
                android:layout_weight="1"
                android:id="@+id/btnCalcular">

            </Button>
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/strLimpiar"
                android:layout_weight="1"
                android:id="@+id/btnLimpiar">

            </Button>
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/strCerrar"
                android:layout_weight="1"
                android:id="@+id/btnCerrar">

            </Button>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/strCalculos"
            android:textAlignment="center"
            android:textSize="30dp"
            android:textColor="@color/red"
            android:textStyle="bold">

        </TextView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strPago"
            android:id="@+id/txtPagoInicial"
            android:textSize="20sp">

        </TextView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strTotalP"
            android:id="@+id/txtTotalFin"
            android:textSize="20sp">

        </TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strPagoMen"
            android:id="@+id/txtPagoMensual"
            android:textSize="20sp">

        </TextView>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>