<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MonedasActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10sp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:text="@string/strTituloMon"
            android:background="@color/titulo"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textSize="20sp"
            android:paddingBottom="10sp"
            android:paddingTop="10sp">
        </TextView>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/strCantM"
            android:textSize="20sp"
            android:paddingTop="10sp"
            android:paddingBottom="10sp"
            android:inputType="numberDecimal"
            android:id="@+id/txtCantidad">
        </EditText>
        <Spinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="15sp"
            android:paddingBottom="15sp"
            android:layout_marginBottom="10sp"
            android:id="@+id/spnMonedas"
            >


        </Spinner>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/txtResultado"
            android:textSize="30sp"
            android:textColor="@color/red"
            android:background="@color/yellow"
            android:textAlignment="center">

        </TextView>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
        </Space>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingBottom="4sp">
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/strBtnConv"
                android:layout_weight="1"
                android:id="@+id/btnConvertir"
                android:textColor="@color/white">
            </Button>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/strLimpiar"
                android:layout_weight="1"
                android:id="@+id/btnLimpiar"
                android:textColor="@color/white">
            </Button>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/strSalir"
                android:layout_weight="1"
                android:id="@+id/btnSalir"
                android:textColor="@color/white">
            </Button>






        </LinearLayout>


    </LinearLayout>




</androidx.constraintlayout.widget.ConstraintLayout>